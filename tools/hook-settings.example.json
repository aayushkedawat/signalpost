{
  "_comment": [
    "Traffic light hook configuration for Claude Code.",
    "",
    "Install:  cp tools/hook-settings.example.json .claude/settings.json",
    "  then restart Claude Code (the settings watcher only watches",
    "  directories that already had a settings file at startup).",
    "",
    "Build first:",
    "  go build -o ~/bin/traffic-light-hook ./server/cmd/traffic-light-hook",
    "and replace the command paths below if you put it elsewhere.",
    "",
    "WAITING comes from Notification (notification_type permission_prompt),",
    "not PermissionRequest: the latter fires whenever the permission system",
    "is consulted, including when a classifier auto-approves with no human",
    "involved, which turns the light red during ordinary work. See",
    "docs/protocol.md section 8.",
    "",
    "PreToolUse, PermissionRequest and SubagentStop are deliberately absent."
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/aayushkedawat/bin/traffic-light-hook",
            "args": [
              "-hook",
              "SessionStart"
            ],
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/aayushkedawat/bin/traffic-light-hook",
            "args": [
              "-hook",
              "UserPromptSubmit"
            ],
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/aayushkedawat/bin/traffic-light-hook",
            "args": [
              "-hook",
              "Notification"
            ],
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/aayushkedawat/bin/traffic-light-hook",
            "args": [
              "-hook",
              "PostToolUse"
            ],
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/aayushkedawat/bin/traffic-light-hook",
            "args": [
              "-hook",
              "PostToolUseFailure"
            ],
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/aayushkedawat/bin/traffic-light-hook",
            "args": [
              "-hook",
              "Stop"
            ],
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/aayushkedawat/bin/traffic-light-hook",
            "args": [
              "-hook",
              "SessionEnd"
            ],
            "async": true,
            "timeout": 5
          }
        ]
      }
    ]
  }
}
